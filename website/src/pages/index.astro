---
import release from '../../../plugin.json';
import '../styles/home.css';
import '../styles/visuals.css';
import TechnicalDiagram from '../components/TechnicalDiagram.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path = '') => `${base}/${path}`;
const repo = 'https://github.com/Agics-hsjeong/project-lifecycle-agent';
const releaseUrl = `${repo}/releases/tag/v${release.version}`;
const profiles = [
  { id: 'si', label: '외주 · SI', count: 11, title: '제안요청서에서 시작하는 사업.', description: '제안에서 약속한 범위를 기획·설계·구현과 연결하고, 납품 후 운영까지 같은 기록으로 관리합니다.', groups: [
    { label: '사업 준비', stages: ['사업 검토', '제안'], files: 'RFP 분석 · 정성제안서 · 발표자료' },
    { label: '구축', stages: ['착수', '기획·설계', '디자인', '퍼블리싱', '구현'], files: '요구사항 · 설계 · 화면 · 코드' },
    { label: '전달과 운영', stages: ['검증', '배포', '인수인계', '유지보수'], files: '테스트 근거 · 배포 기록 · 운영 문서' },
  ] },
  { id: 'product', label: '자체 제품', count: 6, title: '작은 릴리스부터 쌓아가는 제품.', description: '가설과 MVP 범위를 정하고, 이번 릴리스에 필요한 요구사항부터 구현합니다. 이후 백로그는 남겨 둡니다.', groups: [
    { label: '범위 정하기', stages: ['사업 검토', '기획·설계'], files: '제품 가설 · MVP · 수용 기준' },
    { label: '만들고 확인하기', stages: ['구현', '검증'], files: '현재 릴리스의 코드 · 테스트 결과' },
    { label: '다음 릴리스', stages: ['배포', '유지보수'], files: '배포 기록 · 운영 이슈 · 다음 백로그' },
  ] },
  { id: 'api', label: 'API 사업', count: 9, title: '화면보다 인터페이스가 중요한 사업.', description: '제안과 계약의 기준을 API·데이터·권한 설계로 이어갑니다. 디자인과 퍼블리싱 단계는 제외합니다.', groups: [
    { label: '사업 준비', stages: ['사업 검토', '제안', '착수'], files: '제안 범위 · 계약 기준 · 역할' },
    { label: '개발', stages: ['기획·설계', '구현', '검증'], files: 'API 명세 · 코드 · 검증 결과' },
    { label: '전달과 운영', stages: ['배포', '인수인계', '유지보수'], files: '배포 · 인터페이스 인수 · 운영 문서' },
  ] },
  { id: 'maintenance', label: '유지보수', count: 6, title: '이미 운영 중인 서비스의 다음 작업.', description: '현재 상태와 변경 범위를 먼저 확인합니다. 수정 내용과 회귀 테스트를 연결해 운영의 맥락을 남깁니다.', groups: [
    { label: '상태와 범위', stages: ['사업 검토', '기획·설계'], files: '현재 상태 · 변경 영향 · 작업 범위' },
    { label: '수정과 확인', stages: ['구현', '검증'], files: '수정 코드 · 회귀 테스트 · 근거' },
    { label: '운영 반영', stages: ['배포', '유지보수'], files: '배포·복구 기록 · 후속 작업' },
  ] },
];
const resources = [
  { title: '처음 사용하는 분을 위한 가이드', text: '설치하고, 업무 폴더를 열고, 첫 요청을 보내기까지.', action: '가이드 읽기', path: 'docs/start/' },
  { title: '고객 포털 프로젝트 예제', text: '가상 RFP와 요구사항·제안서·발표 구성의 텍스트 예시.', action: '예제 살펴보기', path: 'docs/examples/portal/' },
  { title: '사용자 매뉴얼', text: '설치부터 제안 작성과 유지보수까지, 14페이지 한국어 PDF.', action: 'PDF 다운로드', path: 'downloads/project-ieum-user-guide.pdf', download: true },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Codex와 Claude Code를 위한 오픈소스 프로젝트 관리 플러그인. RFP와 팀의 템플릿으로 시작해 제안·개발·운영의 기준과 기록을 연결합니다." />
    <meta name="theme-color" content="#f7f8f5" />
    <meta property="og:title" content="프로젝트이음 — 일의 기준을 잇다" />
    <meta property="og:description" content="제안부터 운영까지. 팀의 템플릿과 프로젝트 기록으로 Codex·Claude Code의 작업을 이어갑니다." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(url('brand/logo-lockup.png'), Astro.site).href} />
    <link rel="canonical" href={new URL(url(), Astro.site)} />
    <link rel="icon" type="image/png" href={url('brand/symbol.png')} />
    <title>프로젝트이음 — 제안부터 운영까지, 일의 기준을 잇다</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 이동</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={url()} aria-label="프로젝트이음 홈">
          <img src={url('brand/symbol.png')} alt="" width="38" height="25" />
          <span>프로젝트이음</span>
        </a>
        <nav class="desktop-nav" aria-label="주 메뉴">
          <a href="#architecture">아키텍처</a><a href="#workflow">사용 흐름</a>
          <a href="#target-system">목표 시스템</a><a href="#templates">템플릿 활용</a>
          <a href={url('docs/start/')}>문서</a>
          <a href={repo} class="external-link">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
        <a class="button button-small header-install" href="#install">설치하기 <span aria-hidden="true">↓</span></a>
        <details class="mobile-menu">
          <summary aria-label="탐색 메뉴 열기"><span>메뉴</span><span class="menu-lines" aria-hidden="true"></span></summary>
          <nav aria-label="모바일 주 메뉴">
            <a href="#architecture">아키텍처</a><a href="#workflow">사용 흐름</a><a href="#target-system">목표 시스템</a><a href="#templates">템플릿 활용</a>
            <a href={url('docs/start/')}>문서</a><a href={repo}>GitHub ↗</a><a href="#install">설치하기</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <section class="container hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <a class="release-link" href={releaseUrl}><span class="release-mark" aria-hidden="true"></span> v{release.version} <span class="release-divider">/</span> 베타 릴리스 <span aria-hidden="true">↗</span></a>
          <h1 id="hero-title">제안부터 운영까지,<br/><span>일의 기준을 잇다.</span></h1>
          <p class="hero-description">RFP와 팀의 템플릿으로 시작해<br class="desktop-only"/> 요구사항, 산출물, 검토 기록을 연결합니다.</p>
          <p class="hero-definition">Codex · Claude Code용 오픈소스 프로젝트 관리 플러그인</p>
          <div class="hero-actions">
            <a class="button" href="#install">내 작업에 이음 더하기 <span aria-hidden="true">↗</span></a>
            <a class="inline-link" href="#architecture">구조 먼저 살펴보기 <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <figure class="project-fabric">
          <picture><source media="(max-width: 600px)" srcset={url('diagrams/project-fabric-mobile.svg')}/><img src={url('diagrams/project-fabric.svg')} alt="RFP와 팀 템플릿이 프로젝트이음을 거쳐 제안·구축·운영과 하나의 프로젝트 기록으로 이어지는 개념도" width="740" height="555" fetchpriority="high" /></picture>
          <figcaption><span class="mono">FIG. 01</span><span>프로젝트를 잇는 구조</span><span>개념 시각화</span></figcaption>
        </figure>
      </section>

      <div class="container"><div class="principle-strip"><p>한 번 설치하고, 익숙한 대화로.</p><ul><li>내 작업 폴더에 남는 기록</li><li>두 AI가 이어 읽는 프로젝트</li><li>MIT 오픈소스</li></ul></div></div>

      <section class="architecture-section" id="architecture" aria-labelledby="architecture-title">
        <div class="container">
          <div class="section-intro"><div><p class="section-index">01 <span>/</span> 실행 아키텍처</p><h2 id="architecture-title">두 AI 사이에,<br/>하나의 프로젝트 기준.</h2></div><div class="architecture-intro"><p>작업은 익숙한 AI에서.<br/>기준과 기록은 내 프로젝트에.</p><a href={url('docs/guides/v2/')} class="inline-link">v2 기술 가이드 <span aria-hidden="true">↗</span></a></div></div>
          <figure class="technical-figure architecture-figure">
            <div class="figure-toolbar"><span class="mono">IEUM / SYSTEM ARCHITECTURE</span><a href={url('diagrams/architecture.svg')} target="_blank" rel="noopener">원본 SVG 보기 <span aria-hidden="true">↗</span><span class="visually-hidden"> (새 탭)</span></a></div>
            <TechnicalDiagram kind="architecture" />
            <figcaption><span class="mono">FIG. 02</span><p>호스트가 실제 작업을 수행하고, 이음은 상태와 근거를 관리합니다. 대화 이력은 자동 동기화되지 않으며, 프로젝트 파일로 작업을 이어갑니다.</p></figcaption>
          </figure>
          <ol class="engineering-notes"><li><span class="mono">01 / CONSISTENCY</span><h3>같은 기준으로 수정</h3><p>최신 revision을 확인해 관리 정보를 반영하고, 오래된 상태의 덮어쓰기를 막습니다.</p></li><li><span class="mono">02 / EVIDENCE</span><h3>기록보다 실제 근거</h3><p>파일 해시와 검토 근거를 연결합니다. 입력이나 결과가 바뀌면 유효성을 다시 확인합니다.</p></li><li><span class="mono">03 / CONTINUITY</span><h3>중단한 지점에서 계속</h3><p>작업 입력·결과와 HANDOFF.md를 읽고, 유효한 결과와 다음 작업을 구분합니다.</p></li></ol>
        </div>
      </section>

      <section class="container section workflow-section" id="workflow" aria-labelledby="workflow-title">
        <div class="section-intro"><div><p class="section-index">02 <span>/</span> 사용 흐름</p><h2 id="workflow-title">모든 프로젝트가<br/>같은 순서는 아니니까.</h2></div><p class="section-description">사업의 형태에 맞는 단계를 선택하고,<br/>지금 할 일과 다음에 할 일을 구분합니다.</p></div>
        <div class="profile-tabs" role="tablist" aria-label="프로젝트 유형">
          {profiles.map((profile,i) => <button type="button" role="tab" id={`profile-tab-${profile.id}`} aria-controls={`profile-${profile.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-profile-tab={profile.id}>{profile.label}<span aria-hidden="true">↗</span></button>)}
        </div>
        {profiles.map((profile,i) => <div class="profile-panel" role="tabpanel" id={`profile-${profile.id}`} aria-labelledby={`profile-tab-${profile.id}`} hidden={i!==0}>
          <div class="profile-description"><span class="stage-count">{profile.count}개 단계</span><h3>{profile.title}</h3><p>{profile.description}</p><a class="inline-link" href={url('docs/guides/v2/')}>유형별 사용 방법 <span aria-hidden="true">→</span></a></div>
          <ol class="phase-list">{profile.groups.map((group,index) => <li><div class="phase-title"><span class="mono">0{index+1}</span><h4>{group.label}</h4></div><div><p class="phase-stages">{group.stages.map((stage,j) => <><span>{stage}</span>{j<group.stages.length-1 && <span class="stage-separator" aria-hidden="true"> / </span>}</>)}</p><p class="phase-files">{group.files}</p></div></li>)}</ol>
        </div>)}
        <div class="handoff-note"><span class="handoff-mark" aria-hidden="true">↔</span><div><h3>도구를 바꿔도, 처음부터 설명하지 않도록.</h3><p>프로젝트 파일과 HANDOFF.md를 함께 읽어 Codex와 Claude Code에서 이어갑니다. 대화 이력은 자동으로 공유되지 않습니다.</p></div><a href={url('docs/guides/handoff/')} aria-label="Codex와 Claude Code 이어하기 가이드">이어하기 가이드 <span aria-hidden="true">↗</span></a></div>
      </section>

      <section class="target-section" id="target-system" aria-labelledby="target-title">
        <div class="container">
          <div class="section-intro"><div><p class="section-index">03 <span>/</span> 목표 시스템</p><h2 id="target-title">요구사항이,<br/>시스템의 구조가 되도록.</h2></div><p class="section-description">사업의 언어를 화면·서비스·데이터로 풀어냅니다.<br/>어떤 요구가 어느 설계에 반영됐는지, 함께 살펴보세요.</p></div>
          <div class="target-case-heading"><div><span class="case-label">가상 프로젝트 · 설계 예시</span><h3>고객 문의를 하나의 포털로.</h3></div><a class="inline-link" href={url('docs/examples/portal/')}>RFP와 산출물 보기 <span aria-hidden="true">↗</span></a></div>
          <div class="system-lens" role="group" aria-label="목표 시스템 강조 영역"><span class="lens-label">살펴보기</span><button type="button" aria-pressed="true" aria-controls="target-canvas" data-system-view="all">전체 구조</button><button type="button" aria-pressed="false" aria-controls="target-canvas" data-system-view="access">접근 제어</button><button type="button" aria-pressed="false" aria-controls="target-canvas" data-system-view="data">데이터 흐름</button></div>
          <figure class="technical-figure target-figure" id="target-canvas" data-view="all">
            <TechnicalDiagram kind="target" />
            <figcaption><span class="mono">FIG. 03</span><p class="system-view-description" role="status" aria-live="polite">이용자 → 화면 → 권한 검사 → 문의 서비스 → 데이터로 이어지는 구성입니다. 배포·복구 절차와 매뉴얼도 인수 범위에 포함합니다.</p><a href={url('diagrams/target-system.svg')} target="_blank" rel="noopener">원본 SVG <span aria-hidden="true">↗</span><span class="visually-hidden"> (새 탭)</span></a></figcaption>
          </figure>
          <div class="requirement-thread"><div class="thread-origin"><span class="mono">REQ-001 / RFP 2.1</span><p>“고객은 자신의 문의만 볼 수 있다.”</p></div><ol><li><span>설계</span><strong>역할·소유자 검사</strong></li><li><span>구현</span><strong>조회 범위 제한</strong></li><li><span>검증</span><strong>타 고객 접근 차단</strong></li></ol></div>
          <p class="system-disclaimer">공개 가상 RFP를 바탕으로 만든 개념 설계입니다. 실제 구축·운영 화면이 아니며, 인증 방식·기술 제품·호스팅은 확정 전입니다.</p>
        </div>
      </section>

      <section class="template-section" id="templates" aria-labelledby="template-title">
        <div class="container template-layout">
          <div class="template-copy"><p class="section-index">04 <span>/</span> 팀의 템플릿</p><h2 id="template-title">잘 만든 자료를,<br/>다음 제안의 기준으로.</h2><p class="template-description">예전 제안서와 발표자료를 폴더에 넣어 주세요.<br class="desktop-only"/> 목차와 문체, 색상과 서체를 읽고 이번 사업에 맞춰 작성합니다.</p><a class="inline-link" href={url('docs/guides/templates/')}>내 템플릿으로 시작하기 <span aria-hidden="true">→</span></a></div>
          <div class="template-reference">
            <div class="folder-heading"><svg width="20" height="18" viewBox="0 0 20 18" fill="none" aria-hidden="true"><path d="M1 4V1.5h6L9 4h10v12H1V4Z" stroke="currentColor" stroke-width="1.4"/></svg><span class="mono">templates/</span><span>내 프로젝트 폴더</span></div>
            <div class="folder-row"><span class="file-type">DOC</span><div><strong>정성제안서</strong><span class="mono">qualitative/</span></div><span>DOCX · HWPX · PDF</span></div>
            <div class="folder-row"><span class="file-type file-type-slide">PPT</span><div><strong>발표자료</strong><span class="mono">presentation/</span></div><span>PPTX · PDF</span></div>
            <ol class="template-steps"><li><span>01</span><strong>원본 보존</strong><p>프로젝트별로 등록</p></li><li><span>02</span><strong>스타일 선택</strong><p>대표 자료를 분석</p></li><li><span>03</span><strong>결과 검수</strong><p>출력 후 원본과 대조</p></li></ol>
            <p class="reference-note">기존 고객 정보와 실적은 새 사업의 사실로 옮기지 않습니다. 실제 파일 제작·렌더링은 사용하는 AI의 도구로 수행합니다.</p>
          </div>
        </div>
      </section>

      <section class="container section install-section" id="install" aria-labelledby="install-title">
        <div class="install-copy"><p class="section-index">05 <span>/</span> 시작하기</p><h2 id="install-title">지금 쓰는 AI에<br/>이음을 더하세요.</h2><ol class="getting-started"><li><span class="mono">01</span><div><strong>플러그인을 한 번 설치합니다.</strong><p>제품을 선택하고 설치 내용을 전달하세요.</p></div></li><li><span class="mono">02</span><div><strong>새 세션에서 업무 폴더를 엽니다.</strong><p>고객 자료는 플러그인 설치 폴더와 분리합니다.</p></div></li><li><span class="mono">03</span><div><strong>RFP나 사업 아이디어를 전합니다.</strong><p>자료 등록과 진행 기록은 에이전트가 처리합니다.</p></div></li></ol></div>
        <div class="install-panel">
          <div class="install-tabs" role="tablist" aria-label="설치할 AI 선택"><button type="button" role="tab" id="install-tab-codex" aria-controls="install-codex" aria-selected="true" data-install-tab="codex">Codex</button><button type="button" role="tab" id="install-tab-claude" aria-controls="install-claude" aria-selected="false" tabindex="-1" data-install-tab="claude">Claude Code</button></div>
          <div id="install-codex" role="tabpanel" aria-labelledby="install-tab-codex"><p class="install-instruction">Codex <strong>대화 입력창</strong>에 요청하세요.</p><pre id="codex-request" tabindex="0">Agics-hsjeong/project-lifecycle-agent의 main을
marketplace로 등록하고 플러그인을 설치해줘.
설치 버전과 실행 환경도 확인해줘.</pre><button type="button" class="copy-button" data-copy="codex-request" data-copy-label="설치 요청문 복사"><span>설치 요청문 복사</span><svg width="17" height="18" viewBox="0 0 17 18" fill="none" aria-hidden="true"><rect x="5" y="5" width="10" height="11" rx="1" stroke="currentColor"/><path d="M11 3V1H1v11h2" stroke="currentColor"/></svg></button><p class="copy-feedback" role="status" aria-live="polite"></p><a class="install-help" href={url('docs/install/codex/')}>터미널 설치 · 상세 안내 <span aria-hidden="true">↗</span></a></div>
          <div id="install-claude" role="tabpanel" aria-labelledby="install-tab-claude" hidden><p class="install-instruction">Claude Code <strong>대화 입력창</strong>에 한 줄씩 입력하세요.</p><pre id="claude-command" tabindex="0">/plugin marketplace add Agics-hsjeong/project-lifecycle-agent
/plugin install project-lifecycle-agent@project-lifecycle-marketplace</pre><button type="button" class="copy-button" data-copy="claude-command" data-copy-label="설치 명령 복사"><span>설치 명령 복사</span><svg width="17" height="18" viewBox="0 0 17 18" fill="none" aria-hidden="true"><rect x="5" y="5" width="10" height="11" rx="1" stroke="currentColor"/><path d="M11 3V1H1v11h2" stroke="currentColor"/></svg></button><p class="copy-feedback" role="status" aria-live="polite"></p><a class="install-help" href={url('docs/install/claude/')}>설치 범위 · 상세 안내 <span aria-hidden="true">↗</span></a></div>
          <div class="install-version"><span class="version-dot" aria-hidden="true"></span><a href={releaseUrl}>v{release.version} · 베타 릴리스</a><span>설치 후 새 세션에서 사용</span></div>
        </div>
      </section>

      <section class="container resources-section" aria-labelledby="resources-title"><div class="resource-heading"><p class="section-index">06 <span>/</span> 문서와 예제</p><h2 id="resources-title">필요할 때, 바로 찾아보세요.</h2></div><div class="resource-list">{resources.map((resource,i) => <a href={url(resource.path)} download={resource.download || undefined}><span class="resource-index mono">0{i+1}</span><div><h3>{resource.title}</h3><p>{resource.text}</p></div><span class="resource-action">{resource.action}<span aria-hidden="true">{resource.download?'↓':'↗'}</span></span></a>)}</div></section>

      <section class="container faq-section" aria-labelledby="faq-title"><div><p class="section-index">알아두면 좋은 것</p><h2 id="faq-title">시작 전, 궁금한 점.</h2></div><div class="faq-list"><details name="questions"><summary>기존 프로젝트에도 사용할 수 있나요?<span aria-hidden="true">+</span></summary><p>가능합니다. 실제 프로젝트 파일과 현재 상태를 먼저 확인합니다. v2 이행 미리보기와 관리정보 백업을 거치며, 기존 문서·ID·진행 단계를 새 양식으로 덮어쓰지 않습니다. <a href={url('docs/guides/v2/')}>기존 프로젝트 이행 안내 ↗</a></p></details><details name="questions"><summary>제안서와 발표자료도 만들어 주나요?<span aria-hidden="true">+</span></summary><p>RFP와 참고 템플릿을 분석해 정성제안서·발표자료·대본과 제출 점검을 돕습니다. 실제 파일 제작과 전체 출력 검수는 호스트에서 사용할 수 있는 도구로 진행합니다. 텍스트 초안만으로 제출본이 완성됐다고 표시하지 않습니다.</p></details><details name="questions"><summary>프로젝트 자료는 어디에 남나요?<span aria-hidden="true">+</span></summary><p>원본과 산출물, 진행 기록은 사용자가 선택한 프로젝트 폴더에 남습니다. AI에 전달되는 자료는 사용하는 Codex·Claude Code의 데이터 정책과 설정을 따릅니다. 고객 자료를 공개 저장소에 넣지 않도록 별도로 관리하세요.</p></details></div></section>
    </main>

    <footer class="site-footer"><div class="container"><div class="footer-top"><a class="brand" href={url()}><img src={url('brand/symbol.png')} alt="" width="38" height="25"/><span>프로젝트이음</span></a><p>일을 잇는 기록, 프로젝트이음.</p><a class="inline-link" href={`${repo}/issues/new/choose`}>사용 경험 나누기 <span aria-hidden="true">↗</span></a></div><div class="footer-bottom"><span>Project Ieum · 오픈소스 프로젝트 관리 에이전트</span><nav aria-label="하단 메뉴"><a href={repo}>GitHub ↗</a><a href={url('docs/contributing/')}>기여하기</a><a href={`${repo}/blob/main/LICENSE`}>MIT License</a><a href={url('fonts/OFL.txt')}>서체 라이선스</a></nav></div></div></footer>

    <script>
      function setupTabs(selector: string) {
        const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(selector));
        const activate = (selected: HTMLButtonElement) => {
          tabs.forEach(tab => {
            const active = tab === selected;
            tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1;
            const panel = document.getElementById(tab.getAttribute('aria-controls') || '');
            if (panel) panel.hidden = !active;
          });
        };
        tabs.forEach((tab,index) => {
          tab.addEventListener('click', () => activate(tab));
          tab.addEventListener('keydown', event => {
            let next = index;
            if (event.key === 'ArrowRight') next = (index+1)%tabs.length;
            else if (event.key === 'ArrowLeft') next = (index-1+tabs.length)%tabs.length;
            else if (event.key === 'Home') next=0;
            else if (event.key === 'End') next=tabs.length-1;
            else return;
            event.preventDefault(); activate(tabs[next]); tabs[next].focus();
          });
        });
      }
      setupTabs('[data-profile-tab]'); setupTabs('[data-install-tab]');
      const systemViews: Record<string, string> = {
        all: '이용자 → 화면 → 권한 검사 → 문의 서비스 → 데이터로 이어지는 구성입니다. 배포·복구 절차와 매뉴얼도 인수 범위에 포함합니다.',
        access: 'REQ-001: 고객과 운영 담당자의 역할을 구분하고 문의 소유자를 검사합니다. 화면과 데이터 접근 경계에 적용할 설계 기준이며, 실제 인증 방식은 확정 전입니다.',
        data: '문의의 등록·목록·상세·상태와 답변·처리 이력을 연결합니다. FAQ·공지는 방문자에게 공개하고, 개인 문의는 권한 검사 후 접근하도록 설계합니다.',
      };
      document.querySelectorAll<HTMLButtonElement>('[data-system-view]').forEach(button => {
        button.addEventListener('click', () => {
          const view = button.dataset.systemView || 'all';
          const canvas = document.getElementById('target-canvas');
          if (!canvas || !systemViews[view]) return;
          canvas.dataset.view = view;
          document.querySelectorAll<HTMLButtonElement>('[data-system-view]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
          const description = canvas.querySelector('.system-view-description');
          if (description) description.textContent = systemViews[view];
        });
      });
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => {
        let timer: ReturnType<typeof setTimeout>;
        button.addEventListener('click', async () => {
          const source = document.getElementById(button.dataset.copy || '');
          const feedback = button.parentElement?.querySelector('.copy-feedback');
          const label = button.querySelector('span');
          if (!source || !label || !feedback) return;
          clearTimeout(timer);
          try {
            await navigator.clipboard.writeText(source.textContent || '');
            label.textContent = '복사했습니다'; feedback.textContent = '대화 입력창에 붙여넣어 주세요.';
            timer = setTimeout(() => { label.textContent = button.dataset.copyLabel || '복사'; }, 2200);
          } catch {
            const range = document.createRange(); range.selectNodeContents(source);
            const selection = window.getSelection(); selection?.removeAllRanges(); selection?.addRange(range); source.focus();
            label.textContent = button.dataset.copyLabel || '복사'; feedback.textContent = '내용을 선택했습니다. 직접 복사해 주세요.';
          }
        });
      });
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      menu?.addEventListener('toggle', () => { menu.querySelector('summary')?.setAttribute('aria-label', menu.open ? '탐색 메뉴 닫기' : '탐색 메뉴 열기'); });
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
      document.addEventListener('keydown', event => { if(event.key==='Escape' && menu?.open) { menu.open=false; menu.querySelector('summary')?.focus(); } });
    </script>
  </body>
</html>
