---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path = '') => `${base}/${path}`;
const repo = 'https://github.com/Agics-hsjeong/project-lifecycle-agent';
const demos = [
  { id: 'proposal', label: '제안 준비', stage: '02 / 제안', prompt: '이 RFP와 예전 제안서 스타일로\n정성제안서와 발표자료를 만들어줘.', files: ['정성제안서 · 평가항목 대응표', '발표자료 · 대본 · 예상 Q&A', '제출 점검표 · 검수 기록'], next: '제작 파일과 확인할 사업 결정을 함께 정리합니다.' },
  { id: 'delivery', label: '개발 진행', stage: '07 / 구현', prompt: '승인된 우선순위 기능을 구현하고\n관련 테스트와 작업 기록을 갱신해줘.', files: ['요구사항 ↔ 설계 ↔ 코드 연결', '테스트 결과 · 변경 영향', '작업 원장 · HANDOFF.md'], next: '완료한 작업과 다음 작업을 같은 기록으로 이어갑니다.' },
  { id: 'operations', label: '유지보수', stage: '11 / 유지보수', prompt: '이 장애를 등록하고 원인 분석,\n수정과 회귀 검증을 진행해줘.', files: ['장애 기록 · 원인 분석', '수정 · 회귀 테스트 결과', '운영 문서 · 릴리스 기록'], next: '운영에서 생긴 변경을 프로젝트의 맥락에 연결합니다.' },
];
import '../styles/home.css';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="제안부터 운영까지, 프로젝트의 모든 단계를 잇다. RFP와 자기 템플릿으로 시작하는 Codex·Claude Code용 오픈소스 프로젝트 에이전트." />
    <meta name="theme-color" content="#087F8C" />
    <meta property="og:title" content="프로젝트이음 · Project Ieum" />
    <meta property="og:description" content="RFP와 자기 템플릿으로 시작해, 제안·개발·유지보수까지 이어가세요." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(url('brand/logo-lockup.png'), Astro.site).href} />
    <link rel="canonical" href={new URL(url(), Astro.site)} />
    <link rel="icon" type="image/png" href={url('brand/symbol.png')} />
    <title>프로젝트이음 - 제안부터 운영까지, 프로젝트를 잇다</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 이동</a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="brand" href={url()} aria-label="프로젝트이음 홈">
          <img src={url('brand/symbol.png')} width="52" height="28" alt="" />
          <span>프로젝트이음<small>Project Ieum</small></span>
        </a>
        <nav class="desktop-nav" aria-label="주 메뉴">
          <a href="#workflow">어떻게 연결되나요</a>
          <a href={url('docs/start/')}>사용 가이드</a>
          <a href={url('docs/guides/v2/')}>v2 베타</a>
          <a href={repo} class="github-link">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
        <a class="button small header-cta" href={url('docs/start/')}>시작하기 <span aria-hidden="true">↗</span></a>
        <details class="mobile-nav">
          <summary aria-label="메뉴 열기">메뉴 <span aria-hidden="true">☰</span></summary>
          <nav aria-label="모바일 주 메뉴">
            <a href="#workflow">어떻게 연결되나요</a><a href={url('docs/start/')}>사용 가이드</a>
            <a href={url('docs/guides/v2/')}>v2 베타 가이드</a><a href={repo}>GitHub ↗</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot"></span> OPEN SOURCE PROJECT AGENT</p>
          <h1 id="hero-title">제안부터 운영까지,<br/>프로젝트의<br/><span>흐름을 잇다.</span></h1>
          <p class="hero-description">RFP와 자기 템플릿으로 시작하세요.<br/>Codex와 Claude Code가 제안·개발·유지보수의<br class="desktop-break"/> 작업과 기록을 함께 이어갑니다.</p>
          <div class="actions">
            <a class="button" href={url('docs/start/')}>내 프로젝트 시작하기 <span aria-hidden="true">↗</span></a>
            <a class="text-link" href={url('docs/examples/portal/')}>실제 사용 흐름 보기 <span aria-hidden="true">→</span></a>
          </div>
          <div class="hero-meta"><span>Codex</span><i aria-hidden="true">+</i><span>Claude Code</span><b aria-hidden="true">·</b><span>MIT License</span></div>
        </div>
        <div class="demo-shell">
          <div class="demo-top"><span class="project-label"><span class="project-icon" aria-hidden="true">↗</span> a-portal</span><span class="demo-caption">사용 흐름 예시</span></div>
          <div class="demo-tabs" role="tablist" aria-label="업무 예시 선택">
            {demos.map((d, i) => <button role="tab" id={`tab-${d.id}`} aria-controls={`panel-${d.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-demo-tab={d.id}>{d.label}</button>)}
          </div>
          {demos.map((d, i) => <div id={`panel-${d.id}`} role="tabpanel" aria-labelledby={`tab-${d.id}`} hidden={i !== 0} class="demo-panel">
            <p class="stage-label"><span class="status-dot"></span> {d.stage}</p>
            <div class="prompt-bubble"><span class="bubble-label">내가 전할 요청</span><p>{d.prompt}</p></div>
            <div class="connection-line" aria-hidden="true"><span></span><b>이음</b><span></span></div>
            <div class="output-list"><p>에이전트가 이어갈 일</p>{d.files.map((file) => <div><span class="file-icon" aria-hidden="true">▤</span>{file}<span class="file-arrow" aria-hidden="true">↗</span></div>)}</div>
            <p class="demo-note">{d.next}</p>
          </div>)}
          <div class="demo-bottom"><span class="local-indicator"></span> 맥락은 프로젝트 파일에 남습니다.</div>
        </div>
      </section>

      <section class="intro-band" aria-label="프로젝트이음의 작업 방식"><div class="wrap intro-inner"><p>자료와 목표를 전하면,<br/><strong>작업과 기록을 함께.</strong></p><div><span>사용자</span><p>업무 자료 · 원하는 스타일 · 사업 결정</p></div><span class="band-arrow" aria-hidden="true">↔</span><div><span>에이전트</span><p>분석 · 제작 · 검수 · 진행 기록</p></div></div></section>

      <section class="section wrap" id="workflow" aria-labelledby="workflow-title">
        <div class="section-heading"><div><p class="eyebrow">ONE CONNECTED LIFECYCLE</p><h2 id="workflow-title">시작의 맥락이<br/>다음 단계로 이어집니다.</h2></div><p>제안에서 약속한 요구사항이 설계와 구현으로,<br/>검증과 납품의 기록이 운영과 개선으로 연결됩니다.</p></div>
        <div class="lifecycle">
          <article><span class="phase-number">01 - 02</span><h3>사업을 이해하고<br/>제안을 준비합니다.</h3><p>RFP의 요구사항과 평가기준을 정리하고, 제안서·발표·제출 조건을 연결합니다.</p><div class="phase-tags"><span>사업 검토</span><span>제안</span></div></article>
          <article><span class="phase-number">03 - 07</span><h3>확정한 범위를<br/>실제 결과로 만듭니다.</h3><p>역할과 완료 기준을 세우고 기획·설계·화면·코드를 같은 요구사항으로 이어갑니다.</p><div class="phase-tags"><span>착수</span><span>기획·설계</span><span>디자인</span><span>퍼블리싱</span><span>구현</span></div></article>
          <article><span class="phase-number">08 - 11</span><h3>검증하고 전달한 뒤,<br/>운영까지 이어갑니다.</h3><p>검증 증거와 배포·납품 산출물을 남기고, 장애와 변경을 다음 개선에 반영합니다.</p><div class="phase-tags"><span>검증</span><span>배포</span><span>납품</span><span>유지보수</span></div></article>
        </div>
        <a class="text-link" href={url('docs/guides/lifecycle/')}>단계별 관리 방법 읽기 <span aria-hidden="true">→</span></a>
      </section>

      <section class="template-section" aria-labelledby="template-title"><div class="wrap template-inner">
        <div class="reference-art" aria-label="과거 자료에서 새 제안 자료로 이어지는 개념 예시">
          <div class="paper paper-back"><span class="paper-kicker">REFERENCE</span><h3>우리 팀이 쌓아온<br/>제안의 방식.</h3><div class="paper-lines"><i></i><i></i><i></i></div><div class="paper-grid"><span></span><span></span><span></span></div><p>목차 · 문체 · 근거 · 디자인</p></div>
          <span class="paper-bridge" aria-hidden="true">↗</span>
          <div class="paper paper-front"><span class="paper-kicker">NEW PROJECT</span><h3>이번 사업에 맞는<br/>새로운 제안.</h3><div class="paper-rule"></div><div class="paper-chart"><i></i><i></i><i></i><i></i></div><p>새 요구사항과 사실로 작성</p><span class="review-tag">원본과 비교 검수</span></div>
          <p class="art-caption">스타일 활용 개념도 · 실제 제출본 예시는 가이드에서 확인하세요.</p>
        </div>
        <div class="template-copy"><p class="eyebrow">YOUR TEAM'S KNOW-HOW</p><h2 id="template-title">잘 만든 과거 자료가<br/>다음 제안의 기준이 됩니다.</h2><p>예전에 사용한 정성제안서와 발표자료를 폴더에 넣으세요. 색상과 서체, 목차 전개와 설득 방식까지 분석해 이번 사업의 자료를 제작합니다.</p><ul><li><b>원본을 보존하고</b> 프로젝트별 참고 자료로 등록</li><li><b>대표 스타일을 선택해</b> 디자인·문체·구성 분석</li><li><b>새 결과를 렌더링해</b> 원본과 비교 검수</li></ul><p class="fine-print">기존 고객 정보와 실적은 새 사업의 사실로 옮기지 않습니다. 제작·렌더링은 호스트에서 사용할 수 있는 도구로 수행합니다.</p><a class="text-link" href={url('docs/guides/templates/')}>내 템플릿으로 시작하는 방법 <span aria-hidden="true">→</span></a></div>
      </div></section>

      <section class="section wrap install-section" id="install" aria-labelledby="install-title">
        <div class="install-copy"><p class="eyebrow">START WITH YOUR AGENT</p><h2 id="install-title">한 번 설치하고,<br/>대화로 시작하세요.</h2><p>업무 폴더를 열고 목표와 자료를 전달하면 됩니다.<br/>폴더 생성과 원장 갱신, 점검은 에이전트가 처리합니다.</p><a class="text-link" href={url('docs/first-project/')}>첫 프로젝트 따라 하기 <span aria-hidden="true">→</span></a></div>
        <div class="install-box">
          <div class="install-tabs" role="tablist" aria-label="설치할 제품 선택"><button role="tab" aria-selected="true" aria-controls="install-codex" id="install-tab-codex" data-install-tab="codex">Codex</button><button role="tab" aria-selected="false" aria-controls="install-claude" id="install-tab-claude" tabindex="-1" data-install-tab="claude">Claude Code</button></div>
          <div id="install-codex" role="tabpanel" aria-labelledby="install-tab-codex"><p class="input-location">Codex 대화 입력창에 설치를 요청하세요.</p><pre id="codex-request">Agics-hsjeong/project-lifecycle-agent의 main을
marketplace로 등록하고 플러그인을 설치해줘.
설치 상태와 실행 환경도 확인해줘.</pre><button class="copy-button" data-copy="codex-request">요청문 복사 <span aria-hidden="true">⧉</span></button><a href={url('docs/install/codex/')}>터미널 설치 방법과 상세 안내 →</a></div>
          <div id="install-claude" role="tabpanel" aria-labelledby="install-tab-claude" hidden><p class="input-location">Claude Code 대화 입력창에 한 줄씩 입력하세요.</p><pre id="claude-command">/plugin marketplace add Agics-hsjeong/project-lifecycle-agent
/plugin install project-lifecycle-agent@project-lifecycle-marketplace</pre><button class="copy-button" data-copy="claude-command">설치 명령 복사 <span aria-hidden="true">⧉</span></button><a href={url('docs/install/claude/')}>설치 범위와 상세 안내 →</a></div>
          <p class="install-footnote">설치 이름은 project-lifecycle-agent입니다. 설치 후 새 세션에서 사용하세요.</p>
          <span id="copy-status" class="sr-only" role="status" aria-live="polite"></span>
        </div>
      </section>

      <section class="section wrap resources-section" aria-labelledby="resources-title">
        <div class="section-heading"><div><p class="eyebrow">LEARN BY DOING</p><h2 id="resources-title">처음부터 따라가도,<br/>필요한 부분만 찾아도.</h2></div><a href={url('docs/start/')} class="text-link">전체 문서 열기 →</a></div>
        <div class="resource-list">
          <a href={url('docs/examples/portal/')}><span class="resource-index">01</span><div><h3>고객 포털 프로젝트 예제</h3><p>가상 RFP에서 요구사항·제안·발표·인수인계까지. 입력과 결과를 함께 살펴보세요.</p></div><span class="resource-action">예제 보기 ↗</span></a>
          <a href={url('downloads/project-ieum-user-guide.pdf')} download><span class="resource-index">02</span><div><h3>한 권으로 읽는 사용자 매뉴얼</h3><p>설치부터 템플릿 활용과 유지보수까지 정리한 한국어 PDF입니다.</p></div><span class="resource-action">PDF 다운로드 ↓</span></a>
          <a href={url('docs/guides/handoff/')}><span class="resource-index">03</span><div><h3>다른 AI에서도 이어서 작업하기</h3><p>같은 프로젝트 폴더와 인수인계 기록으로 Codex와 Claude Code를 오가세요.</p></div><span class="resource-action">가이드 읽기 ↗</span></a>
        </div>
      </section>

      <section class="final-cta"><div class="wrap"><p class="eyebrow">BUILT IN THE OPEN</p><h2>함께 쓰고,<br/>더 나은 흐름을 만듭니다.</h2><p>프로젝트이음은 MIT 라이선스의 오픈소스입니다.<br/>사용 경험과 개선 아이디어를 GitHub에서 나눠주세요.</p><div class="actions"><a class="button light" href={url('docs/start/')}>프로젝트 시작하기 ↗</a><a class="text-link" href={`${repo}/issues/new/choose`}>피드백 남기기 →</a></div></div></section>
    </main>
    <footer class="site-footer wrap"><a class="brand" href={url()}><img src={url('brand/symbol.png')} width="44" height="24" alt=""/><span>프로젝트이음<small>Project Ieum</small></span></a><p>제안부터 운영까지, 프로젝트의 모든 단계를 잇다.</p><div><a href={repo}>GitHub ↗</a><a href={`${repo}/blob/main/LICENSE`}>MIT License</a><a href={url('docs/contributing/')}>기여하기</a></div></footer>

    <script>
      function setupTabs(selector: string) {
        const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(selector));
        const activate = (tab: HTMLButtonElement) => {
          tabs.forEach(item => {
            const selected = item === tab;
            item.setAttribute('aria-selected', String(selected)); item.tabIndex = selected ? 0 : -1;
            const panel = document.getElementById(item.getAttribute('aria-controls') || '');
            if (panel) panel.hidden = !selected;
          });
        };
        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => activate(tab));
          tab.addEventListener('keydown', (e) => {
            let next = index;
            if (e.key === 'ArrowRight') next = (index + 1) % tabs.length;
            else if (e.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
            else if (e.key === 'Home') next = 0;
            else if (e.key === 'End') next = tabs.length - 1;
            else return;
            e.preventDefault(); activate(tabs[next]); tabs[next].focus();
          });
        });
      }
      setupTabs('[data-demo-tab]'); setupTabs('[data-install-tab]');
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => {
        button.addEventListener('click', async () => {
          const text = document.getElementById(button.dataset.copy || '')?.textContent || '';
          const status = document.getElementById('copy-status');
          try { await navigator.clipboard.writeText(text); button.textContent = '복사 완료 ✓'; if(status) status.textContent = '요청문을 복사했습니다.'; }
          catch { if(status) status.textContent = '자동 복사가 지원되지 않습니다. 요청문을 선택해 복사하세요.'; button.textContent = '본문을 선택해 복사하세요'; }
        });
      });
      document.querySelectorAll('.mobile-nav a').forEach(link => link.addEventListener('click', () => document.querySelector('.mobile-nav')?.removeAttribute('open')));
    </script>
  </body>
</html>
