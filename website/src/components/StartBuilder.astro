---
import '../styles/widgets.css';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<start-builder class="start-builder">
 <div class="builder-heading"><span class="ieum-eyebrow">START YOUR PROJECT</span><h3>내 프로젝트의 첫 요청문.</h3><p>사용할 AI와 업무 유형을 선택하세요. 만들어진 요청문을 AI 대화에 붙여넣으면 됩니다.</p></div>
 <div class="builder-workspace">
  <div class="builder-controls"><fieldset><legend>01 / 사용할 AI</legend><div class="builder-hosts"><button type="button" disabled data-builder-host="codex" aria-pressed="true">Codex</button><button type="button" disabled data-builder-host="claude" aria-pressed="false">Claude Code</button></div></fieldset><label class="builder-select-label"><span>02 / 프로젝트 유형</span><select disabled data-builder-profile><option value="si">외주 · SI — RFP에서 시작</option><option value="product">자체 제품 — MVP에서 시작</option><option value="api">API 사업 — 인터페이스 중심</option><option value="maintenance">유지보수 — 기존 서비스 변경</option></select></label><label class="builder-checkbox"><input type="checkbox" data-builder-templates checked disabled/><span><strong>내 제안서·발표 템플릿 활용</strong><small>이전 자료의 스타일 분석·비교 검수 요청</small></span></label><a class="builder-install" href={`${base}/docs/install/codex/`}>Codex 설치 가이드 <span aria-hidden="true">↗</span></a></div>
  <div class="builder-output"><div class="builder-output-heading"><span><i aria-hidden="true"></i> REQUEST PREVIEW</span><span>대화 입력창에 전달</span></div><label class="builder-sr-only">선택한 조건으로 만든 첫 요청문<textarea data-builder-result readonly rows="9" spellcheck="false">$project-lifecycle
외주·SI 프로필로 새 프로젝트를 시작해줘.
RFP는 첨부하거나 실제 파일 경로를 알려줄게.
프로젝트 폴더를 만들고 원본과 요구사항·고객 질문을 정리해줘.
내 제안서·발표자료를 참고 템플릿으로 등록하고 스타일을 분석해줘.
이전 고객 정보는 새 사업의 사실로 옮기지 말고 전체 출력을 비교 검수해줘.
환경 점검, 단계별 산출물과 HANDOFF.md 기록은 네가 처리해줘.
미정인 범위·예산·일정은 확인 필요로 표시해줘.</textarea></label><div class="builder-output-footer"><span class="builder-status" role="status" aria-live="polite">설치한 AI의 새 세션에서 사용하세요.</span><button type="button" disabled data-builder-copy>요청문 복사 <span aria-hidden="true">↗</span></button></div></div>
 </div>
 <noscript><p class="builder-noscript">브라우저의 JavaScript가 꺼져 있습니다. 기본 요청문을 직접 선택해 복사하거나 아래 문서 안내를 따라 시작하세요.</p></noscript>
</start-builder>
<script>
 class StartBuilder extends HTMLElement {
  connectedCallback(){
   if(this.dataset.ready)return;this.dataset.ready='true';let host='codex';
   const output=this.querySelector<HTMLTextAreaElement>('[data-builder-result]');const profile=this.querySelector<HTMLSelectElement>('[data-builder-profile]');const templates=this.querySelector<HTMLInputElement>('[data-builder-templates]');const install=this.querySelector<HTMLAnchorElement>('.builder-install');const status=this.querySelector('.builder-status');const copy=this.querySelector<HTMLButtonElement>('[data-builder-copy]');
   if(!output||!profile||!templates||!install||!status||!copy)return;
   this.querySelectorAll<HTMLButtonElement|HTMLInputElement|HTMLSelectElement>('button,input,select').forEach(control=>control.disabled=false);
   const base=import.meta.env.BASE_URL.replace(/\/$/,'');
   const profiles:Record<string,string>={si:'외주·SI 프로필로 새 프로젝트를 시작해줘.\nRFP는 첨부하거나 실제 파일 경로를 알려줄게.\n프로젝트 폴더를 만들고 원본과 요구사항·고객 질문을 정리해줘.',product:'자체 제품 프로필로 새 프로젝트를 시작해줘.\n사업 아이디어와 목표를 바탕으로 사용자 문제·가설·MVP와 첫 릴리스 범위를 정리해줘.',api:'API 사업 프로필로 새 프로젝트를 시작해줘.\nRFP와 인터페이스 요구사항을 확인하고 API·데이터·권한 설계와 검증 범위를 정리해줘.',maintenance:'유지보수 프로필로 기존 프로젝트를 분석해줘.\n현재 파일과 운영 상태를 먼저 확인하고 변경 범위·영향·회귀 테스트 계획을 정리해줘.\n기존 문서·ID·진행 기록은 보존해줘.'};
   const update=()=>{output.value=[host==='codex'?'$project-lifecycle':'/project-lifecycle-agent:project-lifecycle',profiles[profile.value],...(templates.checked?['내 제안서·발표자료를 참고 템플릿으로 등록하고 스타일을 분석해줘.','이전 고객 정보는 새 사업의 사실로 옮기지 말고 전체 출력을 비교 검수해줘.']:[]),'환경 점검, 단계별 산출물과 HANDOFF.md 기록은 네가 처리해줘.','미정인 범위·예산·일정은 확인 필요로 표시해줘.'].join('\n');install.href=`${base}/docs/install/${host}/`;install.innerHTML=(host==='codex'?'Codex':'Claude Code')+' 설치 가이드 <span aria-hidden="true">↗</span>';status.textContent='선택한 조건으로 요청문을 만들었습니다.';copy.firstChild!.textContent='요청문 복사 ';};
   this.querySelectorAll<HTMLButtonElement>('[data-builder-host]').forEach(button=>button.addEventListener('click',()=>{host=button.dataset.builderHost||'codex';this.querySelectorAll('[data-builder-host]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));update();}));profile.addEventListener('change',update);templates.addEventListener('change',update);
   copy.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(output.value);status.textContent='복사했습니다. AI 대화 입력창에 붙여넣어 주세요.';copy.firstChild!.textContent='복사 완료 ';}catch{output.focus();output.select();status.textContent='요청문을 선택했습니다. 직접 복사해 주세요.';}});
  }
 }
 if(!customElements.get('start-builder'))customElements.define('start-builder',StartBuilder);
</script>
