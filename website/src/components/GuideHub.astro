---
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const cards=[{number:'01',title:'설치하고 연결하기',text:'쓰고 있는 AI에 이음을 더합니다.',path:'start/#1-사용하는-ai에-한-번-설치하세요',tag:'SETUP'},{number:'02',title:'첫 프로젝트 만들기',text:'자료와 목표로 첫 작업을 시작합니다.',path:'first-project/',tag:'FIRST PROJECT'},{number:'03',title:'내 템플릿 활용하기',text:'제안서와 발표의 스타일을 이어갑니다.',path:'guides/templates/',tag:'YOUR TEMPLATES'},{number:'04',title:'제안부터 운영까지',text:'같은 기준으로 다음 단계를 관리합니다.',path:'guides/lifecycle/',tag:'LIFECYCLE'}];
---
<div class="guide-hub" role="navigation" aria-label="처음 시작하는 문서 선택">{cards.map(card=><a href={`${base}/docs/${card.path}`}><span class="guide-card-top"><span>{card.number}</span><span>{card.tag}</span></span><strong>{card.title}</strong><span class="guide-card-description">{card.text}</span><span class="guide-card-arrow" aria-hidden="true">↗</span></a>)}</div>
