{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "project-lifecycle-agent",
  "version": "2.0.0-beta.3",
  "license": "MIT",
  "description": "Codex·Claude Code에서 제안·기획·설계·개발·검증·인수인계를 돕는 프로젝트 스타트팩 에이전트입니다.",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "프로젝트이음 · Project Ieum",
        "shortDescription": "역할별 협업을 돕는 프로젝트 스타트팩 에이전트",
        "defaultPrompt": [
          "이 제안요청서로 새 프로젝트를 시작해줘."
        ]
      }
    }
  }
}
